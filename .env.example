# Copy to .env on the backend host. Never commit real credentials.
# Use long random hexadecimal database passwords (no URL encoding required).
POSTGRES_PASSWORD=
MONGO_PASSWORD=

# A public IPv4 address or a domain pointing to the server.
# Caddy obtains a public, short-lived HTTPS certificate and renews automatically.
BACKEND_HOST=api.example.com
CLIENT_URL=https://pulse-client-tulipe1735s-projects.vercel.app
ADMIN_URL=https://pulse-admin-rust.vercel.app

# Use the client frontend's existing Clerk application.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


# Quality Engine TEST account. Restricted key: Checkout Sessions Read + Write.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# Optional: an image built on a development machine or CI and pushed to a registry.
PULSE_BACKEND_IMAGE=pulse-backend:local
