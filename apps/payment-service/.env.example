# Server-only restricted Stripe API key; never expose it via NEXT_PUBLIC_*.
STRIPE_API_KEY=
# Signing secret from stripe listen (local) or the deployed webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Optional payment configuration containing Alipay.
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
CLIENT_URL=http://localhost:3002
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Use the existing product database and a separate payment database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pulse_products
PAYMENT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pulse_payments
REDIS_URL=redis://localhost:6379
